# Plantilla de producción SIN valores reales. Copiar a .env y rellenar. .env nunca se versiona.

# ── Entorno ──
NODE_ENV=production
APP_MOUNT_PATH=/site
SITE_URL=https://vhm.com.pe/site
CORS_ORIGIN=https://vhm.com.pe
CRM_PUBLIC_URL=https://vhm.com.pe/crm
PASSENGER_MAX_POOL_SIZE=1

# ── Base de datos ──
DB_HOST=<host>
DB_PORT=3306
DB_USER=<usuario>
DB_PASSWORD='<password>'
DB_NAME=<bd_site>
DB_POOL_MAX=3
DB_POOL_IDLE_MAX=1

# ── Seguridad ──
JWT_SECRET=<aleatorio>
