# ============================================================
# VHM - Libro de Reclamaciones Virtual
# ============================================================
# COPIA este archivo como .env y rellena los valores.
# NUNCA subas .env al repositorio (ya está en .gitignore).
# ============================================================

NODE_ENV=production
PORT=3000
APP_MOUNT_PATH=/site
# En cPanel con URL temporal usa: APP_MOUNT_PATH=/~usuario/site

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_POOL_MAX=5

# JWT - Genera un secret aleatorio: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA uses un valor predecible como "mi_secreto_2026"
JWT_SECRET=
CORS_ORIGIN=https://tudominio.com

# URL pública del sitio (incluye APP_MOUNT_PATH si aplica), para webhooks de Mercado Pago
# Ejemplo: https://vhm.com.pe/site
SITE_URL=

# Secreto de firma de webhooks (panel Mercado Pago > Tus integraciones > Webhooks)
MP_WEBHOOK_SECRET=

# Email de comprador de prueba (solo sandbox). Debe terminar en @testuser.com
# Copialo desde Mercado Pago > Tus integraciones > Cuentas de prueba
MP_SANDBOX_PAYER_EMAIL=test_user_123456789@testuser.com

# Compilación automática del admin Vue al arrancar (app.js).
# ADMIN_SKIP_BUILD=1  → desactiva compilación automática
# ADMIN_FORCE_BUILD=0 → no recompilar en cada restart (solo si cambió el código)

# Chat IA "Clara" (Opción B). Si se define OPENAI_API_KEY, el widget muestra
# un chat embebido en la página. Si se deja vacío, el widget abre el GPT de
# Clara en una ventana emergente (Opción A). NUNCA subir la key real al repo.
OPENAI_API_KEY=
CLARA_MODEL=gpt-4o-mini
# CLARA_SYSTEM_PROMPT=Instrucciones/personalidad de Clara (opcional)
