# Copia como .env.local para desarrollo en tu PC (no se sube al repo).
# Banahosting suele bloquear MySQL remoto: usa túnel SSH o MySQL local.

NODE_ENV=development
PORT=3000
APP_MOUNT_PATH=/site

# Opción A — MySQL local con dump importado
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vhm_site

# Opción B — túnel SSH al servidor (ej. ssh -L 3307:localhost:3306 usuario@servidor)
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_USER=ssfdgwtm_vhm
# DB_PASSWORD=...
# DB_NAME=ssfdgwtm_vhm

JWT_SECRET=dev-secret-cambiar
CORS_ORIGIN=http://localhost:3000
