NODE_ENV=production
PORT=3002
APP_MOUNT_PATH=/luma
PASSENGER_MAX_POOL_SIZE=2

# Base de datos
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_POOL_MAX=3
DB_POOL_IDLE_MAX=1

# JWT — genera uno fuerte: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

CORS_ORIGIN=https://tudominio.com

# Admin inicial (solo si no existe en BD): usuario Luma / luma@luma.com / $LUMA$2026$
# Recuperación en producción: define temporalmente, reinicia la app y quítala después.
# LUMA_BOOTSTRAP_PASSWORD=
