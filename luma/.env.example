# Plantilla de producción SIN valores reales. Copiar a .env y rellenar. .env nunca se versiona.

# ── Entorno ──
NODE_ENV=production
APP_MOUNT_PATH=/luma
CORS_ORIGIN=https://vhm.com.pe
PASSENGER_MAX_POOL_SIZE=1

# ── Base de datos ──
DB_HOST=<host>
DB_PORT=3306
DB_USER=<usuario>
DB_PASSWORD='<password>'
DB_NAME=<bd_luma>
DB_POOL_MAX=3
DB_POOL_IDLE_MAX=1

# ── Seguridad ──
# También se usa como secreto CSRF
JWT_SECRET=<aleatorio>

# Crea el admin protegido (usuario Luma) si no existe, o resetea su contraseña en cada arranque
# mientras esté definida. Usar solo para crear/resetear y luego borrar.
# Si falta al crearlo, se usa una contraseña aleatoria que no se muestra.
# LUMA_BOOTSTRAP_PASSWORD=
