# Plantilla de producción SIN valores reales. Copiar a .env y rellenar. .env nunca se versiona.

# ── Entorno ──
NODE_ENV=production
APP_MOUNT_PATH=/latribu
SITE_URL=https://vhm.com.pe/latribu
CORS_ORIGIN=https://vhm.com.pe
PASSENGER_MAX_POOL_SIZE=1

# ── Base de datos La Tribu ──
DB_HOST=<host>
DB_PORT=3306
DB_USER=<usuario>
DB_PASSWORD='<password>'
DB_NAME=<bd_latribu>
DB_POOL_MAX=3

# ── Seguridad ──
JWT_SECRET=<aleatorio, mínimo 32 caracteres>

# ── Crons (1 en producción: las renovaciones solo corren aquí) ──
TRIBU_RENOVACION_CRON_ENABLED=1
# Protege /latribu/api/tribu-pagos/cron-renovaciones?token=...
TRIBU_RENOVACION_CRON_SECRET=<aleatorio>
TRIBU_CRON_ENABLED=1

# ── Culqi ──
# OBLIGATORIO: vacío = el webhook acepta peticiones sin firma
CULQI_WEBHOOK_SECRET=<secret del webhook en el panel de Culqi>

# ── Opcional ──
# TRIBU_TRIAL_DIAS=
