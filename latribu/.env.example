# Plantilla de producción SIN valores reales. Copiar a .env y rellenar. .env nunca se versiona.

# ── Entorno ──
NODE_ENV=production
APP_MOUNT_PATH=/latribu
SITE_URL=https://vhm.com.pe/latribu
CORS_ORIGIN=https://vhm.com.pe
PASSENGER_MAX_POOL_SIZE=1

# ── Base de datos La Tribu ──
DB_HOST=<host>
DB_PORT=3306
DB_USER=<usuario>
DB_PASSWORD='<password>'
DB_NAME=<bd_latribu>
DB_POOL_MAX=3

# ── Seguridad ──
JWT_SECRET=<aleatorio, mínimo 32 caracteres>

# ── Crons (1 en producción: las renovaciones solo corren aquí) ──
TRIBU_RENOVACION_CRON_ENABLED=1
# Protege /latribu/api/tribu-pagos/cron-renovaciones (cabecera X-Cron-Token, ver CPANEL.md)
TRIBU_RENOVACION_CRON_SECRET=<aleatorio>
TRIBU_CRON_ENABLED=1

# ── Culqi ──
# OBLIGATORIO en producción: vacío = el webhook responde 503
CULQI_WEBHOOK_SECRET=<secret del webhook>
# hmac (x-culqi-signature) | basic (usuario:clave en la URL del webhook) | token (x-webhook-token)
CULQI_WEBHOOK_AUTH=hmac

# ── Correo (mismos nombres que el CRM) ──
SMTP_HOST=<host>
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=<usuario>
SMTP_PASS=<password>
SMTP_FROM="La Tribu VHM <noreply@vhm.com.pe>"

# Solo para node scripts/setup-admin.js (crear el primer Super Admin); luego borrar
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# ── Opcional ──
# TRIBU_TRIAL_DIAS=
# Días de gracia tras fecha_fin mientras la autorrenovación sigue reintentando (defecto 3)
# TRIBU_GRACIA_DIAS=3
