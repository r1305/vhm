# VHM unificado (crm + latribu + luma + site en un proceso: node app.js)
# Copiar a .env en la raíz (o definir las mismas claves en la Node.js App de cPanel).
# Cada app lee SOLO sus claves con prefijo: CRM_, TRIBU_, LUMA_, SITE_.
# Sin prefijo solo van NODE_ENV, PORT y TZ. Ver docs/variables-entorno.md (clave vieja -> nueva).

# ── Comunes ─────────────────────────────────────────────────────
NODE_ENV=production
# PORT solo en local; en cPanel lo asigna Passenger.
PORT=3000
TZ=America/Lima

# ── CRM (/crm) ──────────────────────────────────────────────────
CRM_DB_HOST=localhost
CRM_DB_PORT=3306
CRM_DB_USER=
CRM_DB_PASSWORD=
CRM_DB_NAME=
CRM_DB_POOL_MAX=5
CRM_DB_POOL_IDLE_MAX=2
# Obligatorios en producción. Cadenas largas y aleatorias, distintas entre apps.
CRM_JWT_SECRET=
CRM_SESSION_SECRET=
# Contraseña del admin inicial (solo si la tabla de terapeutas está vacía).
CRM_ADMIN_INITIAL_PASSWORD=
CRM_ASSET_VERSION=
# CORS: origen extra y lista separada por comas.
CRM_FRONTEND_URL=
CRM_CORS_EXTRA=
CRM_DEBUG_CORS=0
CRM_RATE_LIMIT_MAX=100
CRM_AUTH_RATE_LIMIT_MAX=10
# SMTP y OpenWA: los valores guardados en BD (tabla configuracion) prevalecen.
CRM_SMTP_HOST=
CRM_SMTP_PORT=587
CRM_SMTP_SECURE=0
CRM_SMTP_USER=
CRM_SMTP_PASS=
CRM_SMTP_FROM=
CRM_OPENWA_URL=
CRM_OPENWA_API_KEY=
CRM_OPENWA_SESSION=
CRM_OPENWA_WEBHOOK_TOKEN=
# WhatsApp vía Twilio (opcional).
CRM_WA_ACCOUNT_SID=
CRM_WA_AUTH_TOKEN=
CRM_WA_FROM=
CRM_WA_DEFAULT_COUNTRY_CODE=51
CRM_GOOGLE_CLIENT_ID=
CRM_GOOGLE_CLIENT_SECRET=
CRM_GOOGLE_REDIRECT_URI=
CRM_GOOGLE_CALENDAR_REDIRECT_URI=
# Recordatorio 24 h: 1/0 fuerza encendido/apagado; vacío = lo decide la BD.
CRM_RECORDATORIO_24H_ENABLED=
CRM_REC24_HORAS_ANTES=24
CRM_REC24_MIN_HORAS_ANTES=2
CRM_REC24_MAX_INTENTOS=3
CRM_REC24_LOCK_MIN=15
# Ventana de reserva de citas.
CRM_VENTANA_MIN_HORAS=24
CRM_VENTANA_MAX_DIAS=15
# BD de La Tribu vista desde el CRM (si falta host/usuario/clave se usan los CRM_DB_*).
CRM_TRIBU_DB_HOST=
CRM_TRIBU_DB_PORT=
CRM_TRIBU_DB_USER=
CRM_TRIBU_DB_PASSWORD=
CRM_TRIBU_DB_NAME=
CRM_TRIBU_DB_POOL_MAX=3

# ── La Tribu (/latribu) ─────────────────────────────────────────
TRIBU_DB_HOST=localhost
TRIBU_DB_PORT=3306
TRIBU_DB_USER=
TRIBU_DB_PASSWORD=
TRIBU_DB_NAME=
TRIBU_DB_POOL_MAX=3
TRIBU_DB_POOL_IDLE_MAX=1
TRIBU_DB_POOL_IDLE_TIMEOUT=30000
# Firma del admin; los usuarios de la Tribu firman con este valor + "_tribu". También es el secreto CSRF.
TRIBU_JWT_SECRET=
TRIBU_CORS_ORIGIN=
# URL pública de La Tribu, CON /latribu (p. ej. https://vhm.com.pe/latribu).
TRIBU_SITE_URL=
TRIBU_SMTP_HOST=
TRIBU_SMTP_PORT=587
TRIBU_SMTP_SECURE=0
TRIBU_SMTP_USER=
TRIBU_SMTP_PASS=
TRIBU_SMTP_FROM=
# BD de donde se lee la configuración de correo.
TRIBU_EMAIL_CONFIG_DB_NAME=
TRIBU_CULQI_WEBHOOK_SECRET=
TRIBU_CULQI_WEBHOOK_AUTH=hmac
# Crons (los programa solo el proceso unificado): 1 = activo.
TRIBU_CRON_ENABLED=0
TRIBU_RENOVACION_CRON_ENABLED=0
TRIBU_RENOVACION_CRON_SECRET=
TRIBU_GRACIA_DIAS=
TRIBU_TRIAL_DIAS=

# ── LUMA (/luma) ────────────────────────────────────────────────
LUMA_DB_HOST=localhost
LUMA_DB_PORT=3306
LUMA_DB_USER=
LUMA_DB_PASSWORD=
LUMA_DB_NAME=
LUMA_DB_POOL_MAX=3
LUMA_DB_POOL_IDLE_MAX=1
LUMA_DB_POOL_IDLE_TIMEOUT=30000
# También es el secreto CSRF.
LUMA_JWT_SECRET=
LUMA_CORS_ORIGIN=
# Contraseña del primer admin de LUMA (solo si no hay ninguno).
LUMA_BOOTSTRAP_PASSWORD=

# ── Site (/) ────────────────────────────────────────────────────
SITE_DB_HOST=localhost
SITE_DB_PORT=3306
SITE_DB_USER=
SITE_DB_PASSWORD=
SITE_DB_NAME=
SITE_DB_POOL_MAX=3
SITE_DB_POOL_IDLE_MAX=1
SITE_DB_POOL_IDLE_TIMEOUT=30000
# También es el secreto CSRF.
SITE_JWT_SECRET=
SITE_CORS_ORIGIN=
# Origen público del sitio (p. ej. https://vhm.com.pe).
SITE_URL=
# URL pública del CRM; si falta se usa <origen de SITE_URL>/crm.
SITE_CRM_PUBLIC_URL=
