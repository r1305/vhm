# Base de datos La Tribu (site — tabla tribu_users). Mismo host/usuario suele bastar; cambia el nombre.
TRIBU_DB_HOST=
TRIBU_DB_USER=
TRIBU_DB_PASSWORD=
TRIBU_DB_NAME=

# ── Seguridad ─────────────────────────────────────────
JWT_SECRET=
SESSION_SECRET=
COOKIE_SECURE=false

# ── Email (nodemailer) ────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VHM CRM <noreply@vhm.com.pe>

# ── SMS via gateway Android ──────────────────────────
# Instala en un Android: SMS Gateway API / EnvayaSMS / SMS Gateway Me
# SMS_GATEWAY_URL   URL del endpoint HTTP del gateway
# SMS_GATEWAY_TOKEN API key si la app lo requiere (opcional)
# SMS_GATEWAY_TYPE  smsgateway (default) | envaya
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_GATEWAY_TYPE=capcom

# WhatsApp via Twilio (opcional)
WA_ACCOUNT_SID=
WA_AUTH_TOKEN=
WA_FROM=whatsapp:+14155238886

# Meta / Instagram Lead Ads (opcional)
META_WEBHOOK_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=

# TikTok Lead Gen (opcional)
TIKTOK_WEBHOOK_VERIFY_TOKEN=

# ── WhatsApp (Twilio o similar, opcional) ─────────────
