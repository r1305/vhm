# ── Entorno ──────────────────────────────────────────
# Plantilla SIN valores reales. Copiar a .env y rellenar localmente.
# .env nunca se versiona (ver .gitignore).
NODE_ENV=development
PORT=3001
APP_MOUNT_PATH=/crm
# Origen del frontend permitido por CORS (obligatorio en producción).
# Ejemplo: https://vhm.com.pe
FRONTEND_URL=
# Orígenes extra separados por coma (opcional)
CORS_EXTRA=
# Rate limiting global (req/15min por IP). Por defecto 100.
RATE_LIMIT_MAX=100
# Rate limiting estricto de autenticación (intentos/15min). Por defecto 10.
AUTH_RATE_LIMIT_MAX=10
# Versionado de assets del frontend (cache-busting)
CRM_ASSET_VERSION=

# ── Base de datos ────────────────────────────────────
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Base de datos La Tribu (BD separada). Mismo host; usuario y nombre propios.
TRIBU_DB_HOST=
TRIBU_DB_USER=
TRIBU_DB_PASSWORD=
TRIBU_DB_NAME=

# Tamaño máximo del pool de conexiones
PASSENGER_MAX_POOL_SIZE=

# ── Seguridad ────────────────────────────────────────
# Obligatorio en producción (arranque falla si falta).
JWT_SECRET=
# Obligatorio en producción (arranque falla si falta).
SESSION_SECRET=
COOKIE_SECURE=false

# Google OAuth (Calendar / Meet)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_REDIRECT_URI=

# ── Email (nodemailer) ───────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── SMS via gateway Android ──────────────────────────
# Instala en un Android: SMS Gateway API / EnvayaSMS / SMS Gateway Me
# SMS_GATEWAY_URL   URL del endpoint HTTP del gateway
# SMS_GATEWAY_TOKEN API key si la app lo requiere (opcional)
# SMS_GATEWAY_TYPE  smsgateway (default) | envaya
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_GATEWAY_TYPE=

# WhatsApp via Twilio (opcional)
WA_ACCOUNT_SID=
WA_AUTH_TOKEN=
WA_FROM=

# Meta / Instagram Lead Ads (opcional)
META_WEBHOOK_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=

# TikTok Lead Gen (opcional)
TIKTOK_WEBHOOK_VERIFY_TOKEN=
TIKTOK_APP_SECRET=
