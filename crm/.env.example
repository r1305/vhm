# ── Entorno ──────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_MOUNT_PATH=/crm

# ── Base de datos ─────────────────────────────────────
DB_HOST=hd-europe2722.banahosting.com
DB_PORT=3306
DB_USER=ssfdgwtm_crm
DB_PASSWORD=
