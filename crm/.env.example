# Plantilla de producción SIN valores reales. Copiar a .env y rellenar. .env nunca se versiona.

# ── Entorno ──
NODE_ENV=production
APP_MOUNT_PATH=/crm
FRONTEND_URL=https://vhm.com.pe
CORS_EXTRA=
PASSENGER_MAX_POOL_SIZE=1
# Subir en cada deploy con cambios de JS/CSS (cache-busting), ej. 20261009a
CRM_ASSET_VERSION=
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ── Base de datos ──
DB_HOST=<host>
DB_PORT=3306
DB_USER=<usuario>
# Usar comillas simples si la contraseña contiene $
DB_PASSWORD='<password>'
DB_NAME=<bd_crm>
DB_POOL_MAX=5

# ── Base de datos La Tribu ──
TRIBU_DB_HOST=<host>
TRIBU_DB_PORT=3306
TRIBU_DB_USER=<usuario>
TRIBU_DB_PASSWORD='<password>'
TRIBU_DB_NAME=<bd_latribu>

# ── Seguridad (obligatorias en producción: sin ellas no arranca) ──
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=<aleatorio; no cambiarlo o se cierran todas las sesiones>
JWT_SECRET=<aleatorio>

# ── Email (si está configurado en Integraciones, la BD tiene prioridad) ──
SMTP_HOST=<host smtp>
SMTP_PORT=465
# 1 para SSL (puerto 465)
SMTP_SECURE=1
SMTP_USER=<usuario smtp>
SMTP_PASS=
SMTP_FROM=VHM CRM <noreply@vhm.com.pe>

# ── Google OAuth2 (Meet y Calendar) ──
GOOGLE_CLIENT_ID=<client id>
GOOGLE_CLIENT_SECRET=<client secret>
GOOGLE_REDIRECT_URI=https://vhm.com.pe/crm/api/integraciones/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=https://vhm.com.pe/crm/api/terapeutas/google/calendar-callback

# ── Opcionales (valores por defecto) ──
# OpenWA se configura en la BD (Integraciones); estas solo si se quiere forzar por env
# RECORDATORIO_24H_ENABLED=      # 1 fuerza activo, 0 no programa la tarea; vacío = configuracion.recordatorio_24h_activo
# REC24_HORAS_ANTES=24
# REC24_MIN_HORAS_ANTES=2
# REC24_MAX_INTENTOS=3
# REC24_LOCK_MIN=15
# VENTANA_MIN_HORAS=24
# VENTANA_MAX_DIAS=15
