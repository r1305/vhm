<div class="view-toolbar">
  <select class="form-select" id="consPacienteSelect" style="max-width:280px">
    <option value="">— Seleccionar paciente —</option>
    <% pacientes.forEach(p => { %>
    <option value="<%= p.id %>"><%= p.nombre %> <%= p.apellido %></option>
    <% }) %>
  </select>
  <button class="btn btn-primary btn-sm" id="btnNuevoConsentimiento" disabled><i class="fas fa-file-signature"></i> Registrar</button>
</div>
<div id="consContent"><div class="list-empty">Selecciona un paciente</div></div>

