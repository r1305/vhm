<%
const sol = (n) => 'S/ ' + Number(n).toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const total = terapeutas.reduce((a, t) => a + Number(t.ingresos), 0);
const sinPrecio = terapeutas.reduce((a, t) => a + Number(t.sin_precio), 0);
%>
<div class="card">
  <div class="card-header"><span><i class="fas fa-hand-holding-dollar"></i> Ingresos por terapeuta</span></div>
  <% if (terapeutas.length) { %>
  <div class="rf-table-wrap">
    <table class="rf-table">
      <thead><tr><th>Terapeuta</th><th>Paquetes</th><% if (verMontos) { %><th>Ingresos</th><% } %></tr></thead>
      <tbody>
        <% terapeutas.forEach(t => { %>
        <tr>
          <td><%= t.nombre %> <%= t.apellido %></td>
          <td class="rf-num"><%= t.paquetes %></td>
          <% if (verMontos) { %><td class="rf-num rf-ok"><%= sol(t.ingresos) %></td><% } %>
        </tr>
        <% }) %>
        <tr>
          <td><strong>Total</strong></td>
          <td class="rf-num"><strong><%= terapeutas.reduce((a, t) => a + Number(t.paquetes), 0) %></strong></td>
          <% if (verMontos) { %><td class="rf-num"><strong><%= sol(total) %></strong></td><% } %>
        </tr>
      </tbody>
    </table>
  </div>
  <% if (verMontos && sinPrecio) { %>
  <div class="card-body" style="font-size:12px;color:var(--text-muted)"><i class="fas fa-triangle-exclamation"></i> <%= sinPrecio %> paquete(s) asignado(s) sin precio se cuentan como S/ 0,00.</div>
  <% } %>
  <% } else { %><div class="list-empty">Sin datos</div><% } %>
</div>
