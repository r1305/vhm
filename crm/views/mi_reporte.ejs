<div class="card" style="margin-bottom:16px">
  <div class="card-body" style="padding:14px 18px">
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
      <div style="display:flex;align-items:center;gap:8px">
        <label class="form-label" style="margin:0;white-space:nowrap">Desde</label>
        <input type="date" class="form-control" id="mrDesde" style="width:150px">
      </div>
      <div style="display:flex;align-items:center;gap:8px">
        <label class="form-label" style="margin:0;white-space:nowrap">Hasta</label>
        <input type="date" class="form-control" id="mrHasta" style="width:150px">
      </div>
      <div style="display:flex;gap:6px;flex-wrap:wrap">
        <button class="btn btn-outline btn-sm" data-mr-preset="hoy">Hoy</button>
        <button class="btn btn-outline btn-sm" data-mr-preset="semana">Esta semana</button>
        <button class="btn btn-outline btn-sm" data-mr-preset="mes">Este mes</button>
        <button class="btn btn-outline btn-sm" data-mr-preset="mes3">3 meses</button>
      </div>
      <button class="btn btn-primary btn-sm" id="btnAplicarMr"><i class="fas fa-search"></i> Aplicar</button>
    </div>
  </div>
</div>

<div class="kpi-grid" id="mrKpis"></div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px">
  <div class="card">
    <div class="card-header"><i class="fas fa-calendar-check" style="color:var(--primary)"></i> Citas por día</div>
    <div class="card-body" id="mrCitasDia" style="font-size:13px"></div>
  </div>
  <div class="card">
    <div class="card-header"><i class="fas fa-chart-pie" style="color:var(--warning)"></i> Por estado</div>
    <div class="card-body" id="mrEstados" style="font-size:13px"></div>
  </div>
</div>

<div style="margin-top:16px" class="card">
  <div class="card-header"><i class="fas fa-list" style="color:var(--primary)"></i> Detalle de citas</div>
  <div class="card-body" id="mrDetalle"></div>
</div>
