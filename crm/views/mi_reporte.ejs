<div class="card mr-filter-card">
  <div class="card-body">
    <div class="mr-filters">
      <div class="mr-field">
        <label class="form-label" for="mrDesde">Desde</label>
        <input type="date" class="form-control" id="mrDesde">
      </div>
      <div class="mr-field">
        <label class="form-label" for="mrHasta">Hasta</label>
        <input type="date" class="form-control" id="mrHasta">
      </div>
      <div class="mr-presets">
        <button class="btn btn-outline btn-sm" data-mr-preset="hoy">Hoy</button>
        <button class="btn btn-outline btn-sm" data-mr-preset="semana">Esta semana</button>
        <button class="btn btn-outline btn-sm" data-mr-preset="mes">Este mes</button>
        <button class="btn btn-outline btn-sm" data-mr-preset="mes3">3 meses</button>
      </div>
      <button class="btn btn-primary btn-sm" id="btnAplicarMr"><i class="fas fa-search"></i> Aplicar</button>
    </div>
  </div>
</div>

<div class="card mr-summary-card" id="mrSummary"></div>

<div class="kpi-grid" id="mrKpis"></div>

<div class="mr-grid mr-grid-charts">
  <div class="card">
    <div class="card-header"><i class="fas fa-chart-line" style="color:var(--primary)"></i> Actividad diaria</div>
    <div class="card-body" id="mrSparkCitas"></div>
  </div>
  <div class="card">
    <div class="card-header"><i class="fas fa-chart-pie" style="color:var(--warning)"></i> Distribución por estado</div>
    <div class="card-body" id="mrDonutEstado"></div>
  </div>
</div>

<div class="mr-grid mr-grid-secondary">
  <div class="card">
    <div class="card-header"><i class="fas fa-video" style="color:var(--info)"></i> Modalidad de sesiones</div>
    <div class="card-body" id="mrBarModalidad"></div>
  </div>
  <div class="card">
    <div class="card-header"><i class="fas fa-percent" style="color:var(--success)"></i> Tasa de asistencia</div>
    <div class="card-body mr-gauge-wrap" id="mrGauge"></div>
  </div>
</div>

<div class="card mr-detail-card">
  <div class="card-header"><i class="fas fa-list" style="color:var(--primary)"></i> Detalle de citas</div>
  <div class="card-body" id="mrDetalle"></div>
</div>
