<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
  <div class="card">
    <div class="card-header"><span><i class="fab fa-google" style="color:#4285F4"></i> Google Meet</span><span class="badge <%= googleConnected ? 'badge-green' : 'badge-yellow' %>" id="google-status"><%= googleConnected ? 'Conectado' : 'Sin conectar' %></span></div>
    <div class="card-body">
      <p style="font-size:13px;color:var(--text-muted);margin-bottom:12px">Al conectar, cada cita de modalidad <strong>Videollamada</strong> generará automáticamente un link de Google Meet.</p>
      <div style="display:flex;gap:8px">
        <button class="btn btn-primary btn-sm" id="btnGoogleConnect"><i class="fab fa-google"></i> <%= googleConnected ? 'Reconectar' : 'Conectar cuenta Google' %></button>
        <% if (googleConnected) { %><button class="btn btn-outline btn-sm" id="btnGoogleDisconnect"><i class="fas fa-unlink"></i> Desconectar</button><% } %>
      </div>
    </div>
  </div>
  <div class="card">
    <div class="card-header"><span><i class="fab fa-whatsapp" style="color:#25D366"></i> WhatsApp (openwa)</span><span class="badge <%= cfg.openwa_url ? 'badge-green' : 'badge-yellow' %>" id="openwa-status"><%= cfg.openwa_url ? 'Configurado' : 'Sin configurar' %></span></div>
    <div class="card-body">
      <div class="form-group"><label class="form-label">URL de openwa *</label><input class="form-control" id="openwa-url" value="<%= cfg.openwa_url || '' %>" placeholder="https://vhm.com.pe/openwa"></div>
      <div class="form-group"><label class="form-label">API Key *</label><div class="pwd-wrapper"><input type="password" class="form-control" id="openwa-api-key" value="<%= cfg.openwa_api_key || '' %>" placeholder="owa_..."><button type="button" class="pwd-toggle" onclick="togglePwd('openwa-api-key',this)" tabindex="-1"><i class="fas fa-eye"></i></button></div></div>
      <div class="form-group"><label class="form-label">Session ID *</label><input class="form-control" id="openwa-session" value="<%= cfg.openwa_session || '' %>" placeholder="UUID de la sesión activa"></div>
      <div class="form-group"><label class="form-label">Token webhook CRM</label><div class="pwd-wrapper"><input type="password" class="form-control" id="openwa-webhook-token" value="<%= cfg.openwa_webhook_token || '' %>" placeholder="token-secreto-compartido"><button type="button" class="pwd-toggle" onclick="togglePwd('openwa-webhook-token',this)" tabindex="-1"><i class="fas fa-eye"></i></button></div></div>
      <div style="display:flex;gap:8px"><button class="btn btn-primary btn-sm" id="btnSaveOpenwa"><i class="fas fa-save"></i> Guardar</button><button class="btn btn-outline btn-sm" id="btnTestOpenwa"><i class="fab fa-whatsapp"></i> Probar</button></div>
      <hr style="margin:14px 0;border-color:var(--border)">
      <p style="font-size:12px;color:var(--text-muted)"><strong>Webhook URL (configurar en OpenWA):</strong></p>
      <code style="font-size:11px;word-break:break-all;background:var(--bg);padding:6px 8px;border-radius:6px;display:block;margin-top:4px"><%= origin %><%= BASE %>/api/whatsapp/webhook</code>
      <p style="font-size:11px;color:var(--text-muted);margin-top:8px">Usa el mismo token en OpenWA → Webhooks → Authorization Bearer.</p>
    </div>
  </div>
  <div class="card">
    <div class="card-header"><span><i class="fas fa-clock" style="color:var(--primary)"></i> Cron WhatsApp terapeutas</span><span class="badge <%= cron.enabled ? 'badge-green' : 'badge-gray' %>" id="cron-status"><%= cron.enabled ? 'Activo' : 'Desactivado' %></span></div>
    <div class="card-body">
      <div class="form-group" style="display:flex;align-items:center;gap:10px"><label class="form-label" style="margin:0">Activar envío automático</label><input type="checkbox" id="cron-enabled" <%= cron.enabled ? 'checked' : '' %> style="width:18px;height:18px;cursor:pointer"></div>
      <div style="display:flex;gap:12px;flex-wrap:wrap">
        <div class="form-group" style="flex:1;min-width:80px"><label class="form-label">Hora (0-23)</label><input type="number" min="0" max="23" class="form-control" id="cron-hora" value="<%= cron.hora %>"></div>
        <div class="form-group" style="flex:1;min-width:80px"><label class="form-label">Minuto (0-59)</label><input type="number" min="0" max="59" class="form-control" id="cron-minuto" value="<%= cron.minuto %>"></div>
      </div>
      <div class="form-group">
        <label class="form-label">Días de envío</label>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:4px">
          <% [['1','Lun'],['2','Mar'],['3','Mié'],['4','Jue'],['5','Vie'],['6','Sáb'],['0','Dom']].forEach(([v,l]) => { %>
          <label style="display:flex;align-items:center;gap:4px;font-size:13px"><input type="checkbox" class="cron-dia" value="<%= v %>" <%= cronDias.includes(v) ? 'checked' : '' %>> <%= l %></label>
          <% }) %>
        </div>
      </div>
      <div class="form-group"><label class="form-label">Mensaje recordatorio</label><textarea class="form-control" id="cron-mensaje-broadcast" rows="4" placeholder="Hola {nombre}, recuerda revisar tu agenda en el CRM..."><%= cron.mensaje || '' %></textarea><p style="font-size:11px;color:var(--text-muted);margin-top:4px">Se envía solo a usuarios con rol <strong>Terapeuta</strong>, activos y con teléfono WhatsApp registrado. Usa <code>{nombre}</code> para personalizar.</p></div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <button class="btn btn-primary btn-sm" id="btnSaveCron"><i class="fas fa-save"></i> Guardar</button>
        <button class="btn btn-outline btn-sm" id="btnEjecutarCron"><i class="fas fa-play"></i> Ejecutar ahora</button>
        <button class="btn btn-outline btn-sm" id="btnBroadcast"><i class="fab fa-whatsapp" style="color:#25D366"></i> Enviar a todos</button>
        <button class="btn btn-outline btn-sm" id="btnEnviarManual"><i class="fas fa-paper-plane"></i> Enviar a número</button>
      </div>
    </div>
  </div>
</div>

