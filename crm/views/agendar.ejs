<!DOCTYPE html>
<html lang="es" data-product="agenda">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Agendar cita — <%= terapeuta.nombre %> <%= terapeuta.apellido %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="<%= BASE %>/css/agendar.css">
  <script>
    window.__APP_BASE__ = '<%- BASE %>';
    window.__TER_USERNAME__ = '<%- terapeuta.username %>';
    window.__TER_NOMBRE__ = '<%- terapeuta.nombre + " " + terapeuta.apellido %>';
  </script>
</head>
<body>
  <div class="ag-wrap">
    <div class="ag-header">
      <div class="ag-avatar"><%= terapeuta.nombre[0].toUpperCase() %></div>
      <div>
        <div class="ag-ter-nombre"><%= terapeuta.nombre %> <%= terapeuta.apellido %></div>
        <% if (terapeuta.especialidad) { %>
        <div class="ag-ter-esp"><%= terapeuta.especialidad %></div>
        <% } %>
      </div>
    </div>

    <nav class="ag-progress" id="agProgress" aria-label="Progreso de agendamiento">
      <span class="ag-progress-item active" data-step="1"><span class="ag-progress-num">1</span> Fecha</span>
      <span class="ag-progress-sep">·</span>
      <span class="ag-progress-item" data-step="2"><span class="ag-progress-num">2</span> Hora</span>
      <span class="ag-progress-sep">·</span>
      <span class="ag-progress-item" data-step="3"><span class="ag-progress-num">3</span> Datos</span>
    </nav>

    <div class="ag-tz-bar" id="agTzBar">
      <span id="agTzLabel"><i class="fas fa-globe-americas"></i> Hora local: Lima · GMT−5</span>
      <button type="button" class="ag-tz-change" id="agTzToggle">Cambiar zona horaria</button>
    </div>
    <div class="ag-tz-picker" id="agTzPicker" hidden>
      <label for="agTzSelect">Zona horaria</label>
      <select id="agTzSelect">
        <option value="America/Lima">Lima (GMT−5)</option>
        <option value="America/Mexico_City">Ciudad de México (GMT−6)</option>
        <option value="America/Bogota">Bogotá (GMT−5)</option>
        <option value="America/Santiago">Santiago (GMT−4)</option>
        <option value="America/Buenos_Aires">Buenos Aires (GMT−3)</option>
        <option value="America/New_York">Nueva York (GMT−5/−4)</option>
        <option value="America/Los_Angeles">Los Ángeles (GMT−8/−7)</option>
        <option value="Europe/Madrid">Madrid (GMT+1/+2)</option>
      </select>
    </div>

    <div class="ag-steps" id="agSteps">
      <!-- Step 1: elegir día -->
      <div class="ag-step active" id="step1">
        <div class="ag-step-title"><i class="fas fa-calendar-days"></i> Elige un día</div>
        <div class="ag-cal-nav">
          <button class="ag-nav-btn" id="agPrev"><i class="fas fa-chevron-left"></i></button>
          <span id="agMesTitulo"></span>
          <button class="ag-nav-btn" id="agNext"><i class="fas fa-chevron-right"></i></button>
        </div>
        <div id="agCal"></div>
      </div>

      <!-- Step 2: elegir hora -->
      <div class="ag-step" id="step2">
        <button class="ag-back" id="agBackToStep1"><i class="fas fa-arrow-left"></i> Cambiar día</button>
        <div class="ag-step-title"><i class="fas fa-clock"></i> Elige un horario</div>
        <div class="ag-fecha-sel" id="agFechaSel"></div>
        <div id="agSlots"></div>
      </div>

      <!-- Step 3: datos del paciente -->
      <div class="ag-step" id="step3">
        <button class="ag-back" id="agBackToStep2"><i class="fas fa-arrow-left"></i> Cambiar horario</button>
        <div class="ag-step-title"><i class="fas fa-user"></i> Tus datos</div>
        <div class="ag-resumen" id="agResumen"></div>
        <div class="ag-form">
          <div class="ag-field">
            <label>Teléfono *</label>
            <div class="ag-phone-row">
              <select id="ag_pais" class="ag-phone-country" aria-label="País">
                <option value="51">🇵🇪 +51</option>
                <option value="1">🇺🇸 +1</option>
                <option value="34">🇪🇸 +34</option>
                <option value="52">🇲🇽 +52</option>
                <option value="54">🇦🇷 +54</option>
                <option value="56">🇨🇱 +56</option>
                <option value="57">🇨🇴 +57</option>
                <option value="593">🇪🇨 +593</option>
                <option value="58">🇻🇪 +58</option>
              </select>
              <input id="ag_telefono_local" type="tel" placeholder="999 999 999" inputmode="tel" autocomplete="tel-national">
            </div>
            <input type="hidden" id="ag_telefono">
          </div>
          <div class="ag-field"><label>Email</label><input id="ag_email" type="email" placeholder="correo@ejemplo.com"></div>
          <div class="ag-lookup-status" id="agLookupStatus"></div>
          <div class="ag-field-row">
            <div class="ag-field">
              <label>Nombre *</label>
              <input id="ag_nombre" placeholder="Tu nombre" readonly>
            </div>
            <div class="ag-field">
              <label>Apellido *</label>
              <input id="ag_apellido" placeholder="Tu apellido" readonly>
            </div>
          </div>
          <div class="ag-field"><label>Motivo de consulta</label><textarea id="ag_motivo" rows="3" placeholder="Cuéntanos brevemente…"></textarea></div>
          <div class="ag-field">
            <label>Modalidad *</label>
            <div class="ag-modalidad">
              <label class="ag-modalidad-opt">
                <input type="radio" name="ag_modalidad" value="videollamada" checked>
                <span><i class="fas fa-video"></i> Videollamada</span>
              </label>
              <label class="ag-modalidad-opt">
                <input type="radio" name="ag_modalidad" value="presencial">
                <span><i class="fas fa-building"></i> Presencial</span>
              </label>
            </div>
          </div>
          <div id="agErrorMsg" class="ag-error-msg" style="display:none"></div>
          <button class="ag-btn-confirmar" id="agConfirmar">Confirmar cita</button>
        </div>
      </div>

      <!-- Step 4: confirmación -->
      <div class="ag-step" id="step4">
        <div class="ag-exito">
          <div class="ag-exito-icon"><i class="fas fa-circle-check"></i></div>
          <div class="ag-exito-titulo">¡Cita agendada!</div>
          <div class="ag-exito-detalle" id="agExitoDetalle"></div>
          <button class="ag-btn-nuevo" id="agNuevaCita">Agendar otra cita</button>
        </div>
      </div>
    </div>
  </div>

  <script src="<%= BASE %>/agendar.js"></script>
</body>
</html>
