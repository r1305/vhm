<div class="ag-layout">

  <!-- Panel izquierdo -->
  <div class="ag-sidebar">
    <div class="ag-sidebar-top">
      <input class="form-control" id="agendaSearch" placeholder="Buscar paciente…" autocomplete="off">
      <% if (user.rol !== 'terapeuta') { %>
      <select class="form-select" id="agendaTerapeuta">
        <option value="">Todos los terapeutas</option>
        <% terapeutas.forEach(t => { %>
        <option value="<%= t.id %>"><%= t.nombre %> <%= t.apellido %></option>
        <% }) %>
      </select>
      <% } else { %>
      <select class="form-select" id="agendaTerapeuta" disabled>
        <% terapeutas.forEach(t => { %>
        <option value="<%= t.id %>" <%= user.id === t.id ? 'selected' : '' %>><%= t.nombre %> <%= t.apellido %></option>
        <% }) %>
      </select>
      <% } %>
      <div class="ag-sidebar-btns">
        <button class="btn btn-primary btn-sm" id="btnNuevaCita"><i class="fas fa-plus"></i> Nueva cita</button>
        <% if (user.rol !== 'terapeuta') { %>
        <button class="btn btn-outline btn-sm" id="btnCargaMasiva"><i class="fas fa-table"></i> Carga masiva</button>
        <% } %>
      </div>
    </div>
    <div class="ag-pac-list" id="agPacList">
      <div class="ag-list-loading"><i class="fas fa-spinner fa-spin"></i> Cargando…</div>
    </div>
  </div>

  <!-- Panel derecho -->
  <div class="ag-detail" id="agDetail">
    <div class="ag-detail-empty">
      <i class="fas fa-calendar-days"></i>
      <span>Selecciona un paciente</span>
    </div>
  </div>

</div>

<!-- hidden para compatibilidad -->
<select id="agendaPaciente" style="display:none"></select>
