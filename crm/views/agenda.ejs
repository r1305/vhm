<div class="view-toolbar">
  <select class="form-select" id="agendaTerapeuta" style="max-width:200px" <%= user.rol === 'terapeuta' ? 'disabled' : '' %>>
    <option value="">Todos los terapeutas</option>
    <% terapeutas.forEach(t => { %>
    <option value="<%= t.id %>" <%= (user.rol === 'terapeuta' && user.id === t.id) ? 'selected' : '' %>>
      <%= t.nombre %> <%= t.apellido %>
    </option>
    <% }) %>
  </select>
  <select class="form-select" id="agendaPaciente" style="max-width:200px">
    <option value="">Todos los pacientes</option>
    <% pacientes.forEach(p => { %>
    <option value="<%= p.id %>"><%= p.nombre %> <%= p.apellido %></option>
    <% }) %>
  </select>
  <select class="form-select" id="agendaMes" style="max-width:160px">
    <% meses.forEach(m => { %>
    <option value="<%= m.value %>" <%= m.actual ? 'selected' : '' %>><%= m.label %></option>
    <% }) %>
  </select>
  <input type="date" class="form-control" id="agendaDia" style="max-width:150px" title="Filtrar por día (vacío = todo el mes)">
  <button class="btn btn-primary btn-sm" id="btnNuevaCita"><i class="fas fa-plus"></i> Nueva cita</button>
  <% if (user.rol !== 'terapeuta') { %>
  <button class="btn btn-outline btn-sm" id="btnCargaMasiva"><i class="fas fa-table"></i> Carga masiva</button>
  <% } %>
</div>
<div style="margin-top:16px">
  <div class="timeline" id="agendaTimeline"></div>
</div>

