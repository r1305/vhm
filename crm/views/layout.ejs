<!DOCTYPE html>
<html lang="es" data-product="crm">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">
  <link rel="manifest" href="<%= BASE %>/manifest.json">
  <meta name="theme-color" content="#176B87">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="VHM CRM">
  <link rel="apple-touch-icon" href="<%= BASE %>/icons/icon-192.svg">
  <title>VHM CRM — <%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="<%= BASE %>/app.css?v=<%= assetVersion %>">
  <link rel="stylesheet" href="<%= BASE %>/css/<%= view %>.css?v=<%= assetVersion %>">
  <script>(function(){var t=localStorage.getItem('crm-theme')||'dark';document.documentElement.setAttribute('data-theme',t);})();</script>
  <script>window.__APP_BASE__ = '<%- BASE %>'; window.__USER_ROL__ = '<%- user.rol %>'; window.__USER_ID__ = <%= user.id %>;</script>
</head>
<body>

<div class="crm-app">

  <!-- Sidebar -->
  <aside class="crm-sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-logo"><i class="fas fa-heart-pulse"></i></div>
      <span>VHM CRM</span>
    </div>
    <nav class="sidebar-nav">
      <% const principalItems = ['dashboard','agenda','calendario','pacientes','whatsapp','mi_reporte','disponibilidad']; %>
      <% if (principalItems.some(i => menuPermisos.has(i))) { %>
      <div class="nav-section">Principal</div>
      <% } %>
      <% if (menuPermisos.has('dashboard')) { %>
      <a class="nav-item <%= view === 'dashboard'  ? 'active' : '' %>" href="<%= BASE %>/dashboard"><i class="fas fa-gauge-high"></i><span> Dashboard</span></a>
      <% } %>
      <% if (menuPermisos.has('agenda')) { %>
      <a class="nav-item <%= view === 'agenda'     ? 'active' : '' %>" href="<%= BASE %>/agenda"><i class="fas fa-calendar-days"></i><span> Agenda</span></a>
      <% } %>
      <% if (menuPermisos.has('calendario')) { %>
      <a class="nav-item <%= view === 'calendario' ? 'active' : '' %>" href="<%= BASE %>/calendario"><i class="fas fa-calendar-week"></i><span> Calendario</span></a>
      <% } %>
      <% if (menuPermisos.has('pacientes')) { %>
      <a class="nav-item <%= view === 'pacientes'  ? 'active' : '' %>" href="<%= BASE %>/pacientes"><i class="fas fa-users"></i><span> Pacientes</span></a>
      <% } %>
      <% if (menuPermisos.has('whatsapp')) { %>
      <a class="nav-item <%= view === 'whatsapp'   ? 'active' : '' %>" href="<%= BASE %>/whatsapp"><i class="fab fa-whatsapp"></i><span> WhatsApp</span></a>
      <% } %>
      <% if (menuPermisos.has('mi_reporte')) { %>
      <a class="nav-item <%= view === 'mi_reporte'     ? 'active' : '' %>" href="<%= BASE %>/mi-reporte"><i class="fas fa-chart-bar"></i><span> Mi reporte</span></a>
      <% } %>
      <% if (menuPermisos.has('disponibilidad')) { %>
      <a class="nav-item <%= view === 'disponibilidad' ? 'active' : '' %>" href="<%= BASE %>/disponibilidad"><i class="fas fa-clock"></i><span> Disponibilidad</span></a>
      <% } %>


      <% if (menuPermisos.has('historial')) { %>
      <div class="nav-section">Clínico</div>
      <a class="nav-item <%= view === 'historial' ? 'active' : '' %>" href="<%= BASE %>/historial"><i class="fas fa-file-medical"></i><span> Historial</span></a>
      <% } %>
      <% if (menuPermisos.has('encuestas')) { %>
      <a class="nav-item <%= view === 'encuestas' ? 'active' : '' %>" href="<%= BASE %>/encuestas"><i class="fas fa-poll"></i><span> Encuestas</span></a>
      <% } %>

      <% const adminItems = ['analitica','integraciones','paquetes','terapeutas','reportes','permisos_menu']; %>
      <% if (adminItems.some(i => menuPermisos.has(i))) { %>
      <div class="nav-section">Administración</div>
      <% } %>
      <% if (menuPermisos.has('analitica')) { %>
      <a class="nav-item <%= view === 'analitica'    ? 'active' : '' %>" href="<%= BASE %>/analitica"><i class="fas fa-chart-line"></i><span> Analítica web</span></a>
      <% } %>


      <% if (menuPermisos.has('integraciones')) { %>
      <a class="nav-item <%= view === 'integraciones'? 'active' : '' %>" href="<%= BASE %>/integraciones"><i class="fas fa-plug"></i><span> Integraciones</span></a>
      <% } %>
      <% if (menuPermisos.has('paquetes')) { %>
      <a class="nav-item <%= view === 'paquetes'    ? 'active' : '' %>" href="<%= BASE %>/paquetes"><i class="fas fa-box"></i><span> Paquetes</span></a>
      <% } %>
      <% if (menuPermisos.has('terapeutas')) { %>
      <a class="nav-item <%= view === 'terapeutas'   ? 'active' : '' %>" href="<%= BASE %>/terapeutas"><i class="fas fa-user-md"></i><span> Usuarios</span></a>
      <% } %>
      <% if (menuPermisos.has('reportes')) { %>
      <a class="nav-item <%= view === 'reportes'     ? 'active' : '' %>" href="<%= BASE %>/reportes"><i class="fas fa-chart-bar"></i><span> Reportes</span></a>
      <% } %>
      <% if (menuPermisos.has('permisos_menu')) { %>
      <a class="nav-item <%= view === 'permisos_menu'? 'active' : '' %>" href="<%= BASE %>/permisos-menu"><i class="fas fa-shield-halved"></i><span> Permisos de menú</span></a>
      <% } %>
    </nav>
    <div class="sidebar-footer">
      <div class="user-badge">
        <div class="user-avatar"><%= user.nombre[0].toUpperCase() %><%= user.apellido[0].toUpperCase() %></div>
        <div class="user-info">
          <div class="user-name"><%= user.nombre %> <%= user.apellido %></div>
          <div class="user-role"><%= user.rol %></div>
        </div>
        <form method="POST" action="<%= BASE %>/logout" style="margin:0">
          <button class="btn-icon" title="Salir"><i class="fas fa-right-from-bracket"></i></button>
        </form>
      </div>
    </div>
  </aside>
  <div class="sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>

  <!-- Main -->
  <div class="crm-main">
    <header class="crm-topbar">
      <button class="btn-icon sidebar-toggle" id="sidebarToggle" type="button" aria-label="Abrir menú"><i class="fas fa-bars"></i></button>
      <h1 class="page-title"><%= title %></h1>
      <button class="theme-btn" id="themeBtn" title="Cambiar tema"><i class="fas fa-moon"></i></button>
      <button class="theme-btn" id="btnInstallPwa" title="Instalar app" style="display:none"><i class="fas fa-download"></i></button>
    </header>

    <main class="crm-content crm-view-<%= view %>" id="crmContent">
      <%- include(partialView) %>
    </main>
  </div>
</div>

<!-- Modal -->
<div class="modal-overlay" id="modalOverlay">
  <div class="modal" id="modal">
    <div class="modal-header">
      <span class="modal-title" id="modalTitle">Formulario</span>
      <button class="btn-icon" id="modalClose"><i class="fas fa-times"></i></button>
    </div>
    <div class="modal-body" id="modalBody"></div>
    <div class="modal-footer">
      <button class="btn btn-outline" id="modalCancel">Cancelar</button>
      <button class="btn btn-primary" id="modalSave">Guardar</button>
    </div>
  </div>
</div>

<div id="toastContainer"></div>

<div class="crm-loader" id="crmLoader" aria-hidden="true">
  <div class="crm-loader-box">
    <div class="crm-loader-spinner" aria-hidden="true"></div>
    <div class="crm-loader-text" id="crmLoaderText">Procesando…</div>
  </div>
</div>

<div class="crm-dialog-overlay" id="crmDialogOverlay" aria-hidden="true">
  <div class="crm-dialog" role="dialog" aria-modal="true">
    <div class="crm-dialog-title" id="crmDialogTitle">Confirmar</div>
    <div class="crm-dialog-body" id="crmDialogBody"></div>
    <input type="text" class="form-control crm-dialog-input" id="crmDialogInput" style="display:none">
    <div class="crm-dialog-actions">
      <button type="button" class="btn btn-outline" id="crmDialogCancel">Cancelar</button>
      <button type="button" class="btn btn-primary" id="crmDialogConfirm">Confirmar</button>
    </div>
  </div>
</div>

<!-- Banner iOS install -->
<div id="iosInstallBanner" style="display:none" role="dialog" aria-modal="true" aria-labelledby="iosInstallTitle">
  <div class="ios-install-backdrop"></div>
  <div class="ios-install-sheet">
    <button type="button" class="ios-install-close" id="iosInstallClose" aria-label="Cerrar">&times;</button>
    <div class="ios-install-icon"><i class="fas fa-heart-pulse"></i></div>
    <div class="ios-install-title" id="iosInstallTitle">Instala VHM CRM</div>
    <div class="ios-install-sub">Accede más rápido desde tu pantalla de inicio, sin abrir el navegador.</div>
    <ol class="ios-install-steps">
      <li>
        <span class="ios-step-num">1</span>
        <span>Abre esta página en <strong>Safari</strong> <span class="ios-browser-badge"><i class="fab fa-safari"></i> Safari</span></span>
      </li>
      <li>
        <span class="ios-step-num">2</span>
        <span>Toca el botón <strong>Compartir</strong> en la barra inferior
          <span class="ios-share-icon" aria-hidden="true">
            <svg width="18" height="22" viewBox="0 0 18 22" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M9 1v13M4 5l5-5 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="1" y="9" width="16" height="12" rx="2" stroke="currentColor" stroke-width="2"/>
            </svg>
          </span>
        </span>
      </li>
      <li>
        <span class="ios-step-num">3</span>
        <span>Selecciona <strong>"Agregar a pantalla de inicio"</strong> <span class="ios-add-icon" aria-hidden="true">＋</span></span>
      </li>
    </ol>
    <button type="button" class="ios-install-dismiss" id="iosInstallDismiss">Ahora no</button>
  </div>
</div>

<script src="<%= BASE %>/app.js?v=<%= assetVersion %>"></script>
<script>
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('<%= BASE %>/sw.js?v=<%= assetVersion %>').catch(() => {});
  }
  (function () {
    const DISMISS_KEY = 'crm-ios-install-dismissed';
    const DISMISS_DAYS = 7;

    function isIos() {
      return /iphone|ipad|ipod/i.test(navigator.userAgent);
    }
    function isStandalone() {
      return window.navigator.standalone === true ||
             window.matchMedia('(display-mode: standalone)').matches;
    }
    function wasDismissed() {
      const ts = parseInt(localStorage.getItem(DISMISS_KEY) || '0', 10);
      return ts && (Date.now() - ts) < DISMISS_DAYS * 86400000;
    }

    let _deferredPrompt = null;
    const btn = document.getElementById('btnInstallPwa');
    const banner = document.getElementById('iosInstallBanner');

    // Android/Chrome: prompt nativo
    window.addEventListener('beforeinstallprompt', e => {
      e.preventDefault();
      _deferredPrompt = e;
      if (btn) btn.style.display = 'flex';
    });
    window.addEventListener('appinstalled', () => {
      _deferredPrompt = null;
      if (btn) btn.style.display = 'none';
    });

    // iOS: mostrar botón si no está instalado y no fue descartado
    if (isIos() && !isStandalone() && !wasDismissed()) {
      if (btn) btn.style.display = 'flex';
    }

    function showIosBanner() {
      if (!banner) return;
      banner.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
    function hideIosBanner(dismiss) {
      if (!banner) return;
      banner.style.display = 'none';
      document.body.style.overflow = '';
      if (dismiss) localStorage.setItem(DISMISS_KEY, String(Date.now()));
    }

    document.getElementById('iosInstallClose')?.addEventListener('click', () => hideIosBanner(true));
    document.getElementById('iosInstallDismiss')?.addEventListener('click', () => hideIosBanner(true));
    document.getElementById('iosInstallBanner')?.querySelector('.ios-install-backdrop')
      ?.addEventListener('click', () => hideIosBanner(true));

    if (btn) {
      btn.addEventListener('click', async () => {
        if (_deferredPrompt) {
          _deferredPrompt.prompt();
          const { outcome } = await _deferredPrompt.userChoice;
          _deferredPrompt = null;
          if (outcome === 'accepted') {
            btn.style.display = 'none';
            fetch('<%= BASE %>/api/pwa/install', { method: 'POST', credentials: 'same-origin' }).catch(() => {});
          }
        } else if (isIos()) {
          showIosBanner();
        }
      });
    }
  })();
</script>
<%- scripts %>
</body>
</html>
