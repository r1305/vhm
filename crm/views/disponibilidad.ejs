<div id="dispWrap">
  <% if (terapeutas.length > 1) { %>
  <div style="margin-bottom:18px;display:flex;align-items:center;gap:10px">
    <label style="font-size:13px;font-weight:600">Terapeuta:</label>
    <select class="form-select" id="selTerapeuta" style="max-width:220px">
      <% terapeutas.forEach(t => { %>
      <option value="<%= t.id %>"><%= t.nombre %> <%= t.apellido %></option>
      <% }) %>
    </select>
  </div>
  <% } %>

  <div id="dispGrid"></div>

  <div style="margin-top:20px;background:var(--card-bg);border:1px solid var(--border);border-radius:10px;padding:14px 16px">
    <div style="font-size:12px;color:var(--text-muted);margin-bottom:6px">Link público de agendamiento:</div>
    <div style="display:flex;align-items:center;gap:8px">
      <code id="dispLink" style="flex:1;font-size:12px;word-break:break-all;color:var(--text)"></code>
      <button class="btn btn-outline btn-sm" id="btnCopyLink"><i class="fas fa-copy"></i> Copiar</button>
      <a class="btn btn-outline btn-sm" id="btnOpenLink" href="#" target="_blank"><i class="fas fa-external-link-alt"></i></a>
    </div>
  </div>
</div>
