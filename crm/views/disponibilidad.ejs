<div id="dispWrap">
  <% if (terapeutas.length > 1) { %>
  <div style="margin-bottom:18px;display:flex;align-items:center;gap:10px;flex-wrap:wrap">
    <label style="font-size:13px;font-weight:600">Terapeuta:</label>
    <select class="form-select" id="selTerapeuta" style="max-width:220px">
      <% terapeutas.forEach(t => { %>
      <option value="<%= t.id %>"><%= t.nombre %> <%= t.apellido %></option>
      <% }) %>
    </select>
  </div>
  <% } %>

  <div id="dispGrid"></div>

  <div class="disp-link-box">
    <div class="disp-link-label">Link público de agendamiento:</div>
    <div class="disp-link-row">
      <code id="dispLink"></code>
      <button class="btn btn-outline btn-sm" id="btnCopyLink"><i class="fas fa-copy"></i> Copiar</button>
      <a class="btn btn-outline btn-sm" id="btnOpenLink" href="#" target="_blank"><i class="fas fa-external-link-alt"></i> Abrir</a>
    </div>
  </div>
</div>
