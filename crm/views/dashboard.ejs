<%/* ── KPIs ── */%>
<div class="kpi-grid" id="kpiGrid">
  <% kpis.forEach(k => { %>
  <div class="kpi-card <%= k.css %>">
    <div class="kpi-label"><%= k.label %></div>
    <div class="kpi-value"><%= k.value %></div>
    <% if (k.sub) { %><div class="kpi-sub"><%= k.sub %></div><% } %>
  </div>
  <% }) %>
</div>

<div class="dash-grid">

  <%/* ── Próximos a agotar sesiones ── */%>
  <div class="card">
    <div class="card-header">
      <span><i class="fas fa-hourglass-half" style="color:#f59e0b"></i> Próximos a agotar sesiones</span>
      <span class="dash-badge"><%= proximosAgotar.length %></span>
    </div>
    <% if (proximosAgotar.length) { %>
    <div class="dash-list">
      <% proximosAgotar.forEach(p => { const r = p.sesiones_total - p.sesiones_usadas; %>
      <div class="list-item">
        <div class="list-icon sesiones-icon-<%= r <= 0 ? 'cero' : 'pocas' %>">
          <i class="fas fa-<%= r <= 0 ? 'ban' : 'hourglass-half' %>"></i>
        </div>
        <div style="flex:1">
          <div class="list-title"><%= p.nombre %> <%= p.apellido %></div>
          <div class="list-meta"><%= p.terapeuta_nombre || '—' %> · <%= p.telefono || 'Sin tel.' %></div>
        </div>
        <span class="badge-sesiones badge-sesiones-<%= r <= 0 ? 'cero' : 'pocas' %>">
          <%= r <= 0 ? 'Agotadas' : r + ' restante' + (r === 1 ? '' : 's') %>
        </span>
      </div>
      <% }) %>
    </div>
    <% } else { %><div class="list-empty">Ningún paciente próximo a agotar</div><% } %>
  </div>

  <%/* ── En riesgo de abandono ── */%>
  <div class="card">
    <div class="card-header">
      <span><i class="fas fa-user-clock" style="color:#ef4444"></i> En riesgo de abandono</span>
      <span class="dash-badge dash-badge-red"><%= enRiesgo.length %></span>
    </div>
    <% if (enRiesgo.length) { %>
    <div class="dash-list">
      <% enRiesgo.forEach(p => { %>
      <div class="list-item">
        <div class="list-icon" style="background:#fee2e2;color:#dc2626"><i class="fas fa-user-slash"></i></div>
        <div style="flex:1">
          <div class="list-title"><%= p.nombre %> <%= p.apellido %></div>
          <div class="list-meta"><%= p.terapeuta_nombre || '—' %> · <%= p.telefono || 'Sin tel.' %></div>
        </div>
        <span class="badge-riesgo">
          <%= p.ultima_cita ? 'Últ. ' + new Date(p.ultima_cita).toLocaleDateString('es-PE',{day:'2-digit',month:'short'}) : 'Sin citas' %>
        </span>
      </div>
      <% }) %>
    </div>
    <% } else { %><div class="list-empty">Sin pacientes en riesgo</div><% } %>
  </div>

  <%/* ── Activos sin paquete ── */%>
  <div class="card">
    <div class="card-header">
      <span><i class="fas fa-box-open" style="color:#f97316"></i> Activos sin paquete asignado</span>
      <span class="dash-badge dash-badge-orange"><%= sinPaquete.length %></span>
    </div>
    <% if (sinPaquete.length) { %>
    <div class="dash-list">
      <% sinPaquete.forEach(p => { %>
      <div class="list-item">
        <div class="list-icon" style="background:#ffedd5;color:#ea580c"><i class="fas fa-box-open"></i></div>
        <div style="flex:1">
          <div class="list-title"><%= p.nombre %> <%= p.apellido %></div>
          <div class="list-meta"><%= p.terapeuta_nombre || '—' %> · <%= p.telefono || 'Sin tel.' %></div>
        </div>
      </div>
      <% }) %>
    </div>
    <% } else { %><div class="list-empty">Todos los activos tienen paquete</div><% } %>
  </div>

  <%/* ── Paquetes vencidos con sesiones sin usar ── */%>
  <div class="card">
    <div class="card-header">
      <span><i class="fas fa-calendar-xmark" style="color:#dc2626"></i> Paquetes vencidos con sesiones</span>
      <span class="dash-badge dash-badge-red"><%= packVencidos.length %></span>
    </div>
    <% if (packVencidos.length) { %>
    <div class="dash-list">
      <% packVencidos.forEach(p => { %>
      <div class="list-item">
        <div class="list-icon" style="background:#fee2e2;color:#dc2626"><i class="fas fa-calendar-xmark"></i></div>
        <div style="flex:1">
          <div class="list-title"><%= p.nombre %> <%= p.apellido %></div>
          <div class="list-meta"><%= p.pack_nombre %> · venció <%= new Date(p.vence_at).toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'numeric'}) %></div>
        </div>
        <span class="badge-riesgo"><%= p.sesiones_restantes %> ses.</span>
      </div>
      <% }) %>
    </div>
    <% } else { %><div class="list-empty">Sin paquetes vencidos con sesiones</div><% } %>
  </div>

  <%/* ── Ocupación por terapeuta ── */%>
  <div class="card">
    <div class="card-header">
      <span><i class="fas fa-users" style="color:#10b981"></i> Ocupación por terapeuta</span>
      <% if (lista_espera > 0) { %>
      <span class="dash-badge dash-badge-orange"><%= lista_espera %> en espera</span>
      <% } %>
    </div>
    <% if (ocupacion.length) { %>
    <div class="dash-list">
      <% ocupacion.forEach(t => { %>
      <div class="list-item">
        <div class="list-icon" style="background:#d1fae5;color:#059669"><i class="fas fa-user-tie"></i></div>
        <div style="flex:1">
          <div class="list-title"><%= t.nombre %> <%= t.apellido %></div>
        </div>
        <span class="badge-ocupacion"><%= t.pacientes_asignados %> paciente<%= t.pacientes_asignados !== 1 ? 's' : '' %></span>
      </div>
      <% }) %>
    </div>
    <% } else { %><div class="list-empty">Sin terapeutas activos</div><% } %>
  </div>

</div>
