<div class="card" style="margin-bottom:16px">
  <div class="card-body" style="padding:14px 18px">
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
      <div style="display:flex;align-items:center;gap:8px">
        <label class="form-label" style="margin:0;white-space:nowrap">Desde</label>
        <input type="date" class="form-control" id="rfDesde" style="width:150px" value="<%= desde %>">
      </div>
      <div style="display:flex;align-items:center;gap:8px">
        <label class="form-label" style="margin:0;white-space:nowrap">Hasta</label>
        <input type="date" class="form-control" id="rfHasta" style="width:150px" value="<%= hasta %>">
      </div>
      <div style="display:flex;gap:6px;flex-wrap:wrap">
        <button class="btn btn-outline btn-sm" data-rf-preset="hoy">Hoy</button>
        <button class="btn btn-outline btn-sm" data-rf-preset="semana">Esta semana</button>
        <button class="btn btn-outline btn-sm" data-rf-preset="mes">Este mes</button>
        <button class="btn btn-outline btn-sm" data-rf-preset="mes3">3 meses</button>
      </div>
      <button class="btn btn-primary btn-sm" id="btnAplicarFiltroRF"><i class="fas fa-search"></i> Aplicar</button>
    </div>
  </div>
</div>

<%/* ── KPIs ── */%>
<div class="kpi-grid" id="kpiGrid">
  <% kpis.forEach(k => { %>
  <div class="kpi-card">
    <div class="kpi-label"><%= k.label %></div>
    <div class="kpi-value"><%= k.value %></div>
    <% if (k.sub) { %><div class="kpi-sub"><%= k.sub %></div><% } %>
    <% if (k.state === 'ok') { %><span class="kpi-state kpi-state-ok">En meta</span><% } %>
    <% if (k.state === 'warn') { %><span class="kpi-state kpi-state-warn">Revisar</span><% } %>
  </div>
  <% }) %>
</div>

<%
  const ESTADO_LBL = { pendiente:'Pendiente', confirmada:'Confirmada', reagendada:'Reagendada', realizada:'Realizada', cancelada:'Cancelada', no_show:'No show' };
  const ESTADO_COL = { pendiente:'#A66A13', confirmada:'#3E6FA4', reagendada:'#64B5CE', realizada:'#237A68', cancelada:'#B64A5A', no_show:'#8A8F98' };
  const estTotal = citasEstado.reduce((s, r) => s + Number(r.total), 0);
  let acc = 0;
  const donut = citasEstado.map(r => { const a = acc; acc += Number(r.total) / estTotal * 100; return `${ESTADO_COL[r.estado] || '#8A8F98'} ${a}% ${acc}%`; }).join(',');
  const maxDia = Math.max(1, ...serieDias.map(d => d.total));
  const maxTer = Math.max(1, ...citasTerapeuta.map(t => Number(t.total)));
  const vend = Number(sesiones.vendidas), usadas = Number(sesiones.usadas);
  const pctUso = vend > 0 ? Math.min(100, Math.round(usadas / vend * 100)) : 0;
%>

<div class="kpi-grid">
  <% periodoKpis.forEach(k => { %>
  <div class="kpi-card">
    <div class="kpi-label"><%= k.label %></div>
    <div class="kpi-value"><%= k.value %></div>
    <div class="kpi-sub"><%= k.sub %></div>
  </div>
  <% }) %>
</div>

<div class="dash-grid dash-charts">
  <div class="card dash-wide">
    <div class="card-header"><span><i class="fas fa-chart-column"></i> Citas por día (sin canceladas)</span><span class="dash-badge"><%= desde %> a <%= hasta %></span></div>
    <div class="card-body">
      <% if (serieDias.some(d => d.total)) { %>
      <svg class="dash-bars" viewBox="0 0 <%= serieDias.length * 10 %> 100" preserveAspectRatio="none" role="img" aria-label="Citas por día">
        <% serieDias.forEach((d, i) => { const h = d.total / maxDia * 90; %>
        <rect x="<%= i * 10 + 1 %>" y="<%= 100 - h %>" width="8" height="<%= h %>" rx="1" fill="#176B87"><title><%= d.dia %>: <%= d.total %></title></rect>
        <% }) %>
      </svg>
      <div class="dash-axis"><span><%= serieDias[0].dia %></span><span>máx. <%= maxDia %>/día</span><span><%= serieDias[serieDias.length - 1].dia %></span></div>
      <% } else { %><div class="list-empty">Sin citas en este periodo</div><% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><span><i class="fas fa-chart-pie"></i> Citas por estado</span></div>
    <div class="card-body">
      <% if (estTotal > 0) { %>
      <div class="dash-donut-wrap">
        <div class="dash-donut" style="background:conic-gradient(<%= donut %>)"><span><%= estTotal %></span></div>
        <div class="dash-legend">
          <% citasEstado.forEach(r => { %>
          <div><i style="background:<%= ESTADO_COL[r.estado] || '#8A8F98' %>"></i><%= ESTADO_LBL[r.estado] || r.estado %> <strong><%= r.total %></strong></div>
          <% }) %>
        </div>
      </div>
      <% } else { %><div class="list-empty">Sin citas en este periodo</div><% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><span><i class="fas fa-user-doctor"></i> Citas por terapeuta</span></div>
    <div class="card-body">
      <% if (citasTerapeuta.length) { %>
      <% citasTerapeuta.forEach(t => { %>
      <div class="dash-hbar">
        <div class="dash-hbar-label" title="<%= t.nombre %> <%= t.apellido %>"><%= t.nombre %> <%= t.apellido ? t.apellido[0] + '.' : '' %></div>
        <div class="dash-hbar-track"><div style="width:<%= Number(t.total) / maxTer * 100 %>%"></div></div>
        <div class="dash-hbar-val"><%= t.total %></div>
      </div>
      <% }) %>
      <% } else { %><div class="list-empty">Sin terapeutas activos</div><% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><span><i class="fas fa-ticket"></i> Sesiones de pacientes activos</span></div>
    <div class="card-body">
      <% if (vend > 0) { %>
      <div class="dash-hbar-track dash-hbar-lg"><div style="width:<%= pctUso %>%"></div></div>
      <div class="dash-axis"><span><%= usadas %> usadas (<%= pctUso %>%)</span><span><%= Number(sesiones.pendientes) %> pendientes</span><span><%= vend %> vendidas</span></div>
      <% } else { %><div class="list-empty">Sin sesiones vendidas</div><% } %>
    </div>
  </div>
</div>

<div class="dash-grid">

  <%/* ── Próximos a agotar sesiones ── */%>
  <div class="card">
    <div class="card-header">
      <span><i class="fas fa-hourglass-half"></i> Próximos a agotar sesiones</span>
      <span class="dash-badge"><%= proximosAgotar.length %></span>
    </div>
    <% if (proximosAgotar.length) { %>
    <div class="dash-list">
      <% proximosAgotar.forEach(p => { const r = p.sesiones_restantes; %>
      <div class="list-item">
        <div class="list-icon">
          <i class="fas fa-<%= r <= 0 ? 'ban' : 'hourglass-half' %>"></i>
        </div>
        <div style="flex:1">
          <div class="list-title"><%= p.nombre %> <%= p.apellido %></div>
          <div class="list-meta"><%= p.terapeuta_nombre || '—' %> · <%= p.telefono || 'Sin tel.' %></div>
        </div>
        <span class="badge-sesiones badge-sesiones-<%= r <= 0 ? 'cero' : 'pocas' %>">
          <%= r <= 0 ? 'Agotadas' : r + ' restante' + (r === 1 ? '' : 's') %>
        </span>
      </div>
      <% }) %>
    </div>
    <% } else { %><div class="list-empty">Ningún paciente próximo a agotar</div><% } %>
  </div>

  <%/* ── En riesgo de abandono ── */%>
  <div class="card">
    <div class="card-header">
      <span><i class="fas fa-user-clock"></i> En riesgo de abandono</span>
      <span class="dash-badge dash-badge-red"><%= enRiesgo.length %></span>
    </div>
    <% if (enRiesgo.length) { %>
    <div class="dash-list">
      <% enRiesgo.forEach(p => { %>
      <div class="list-item">
        <div class="list-icon"><i class="fas fa-user-slash"></i></div>
        <div style="flex:1">
          <div class="list-title"><%= p.nombre %> <%= p.apellido %></div>
          <div class="list-meta"><%= p.terapeuta_nombre || '—' %> · <%= p.telefono || 'Sin tel.' %></div>
        </div>
        <span class="badge-riesgo">
          <%= p.ultima_cita ? 'Últ. ' + new Date(p.ultima_cita).toLocaleDateString('es-PE',{day:'2-digit',month:'short'}) : 'Sin citas' %>
        </span>
      </div>
      <% }) %>
    </div>
    <% } else { %><div class="list-empty">Sin pacientes en riesgo</div><% } %>
  </div>

  <%/* ── Activos sin paquete ── */%>
  <div class="card">
    <div class="card-header">
      <span><i class="fas fa-box-open"></i> Activos sin paquete asignado</span>
      <span class="dash-badge dash-badge-orange"><%= sinPaquete.length %></span>
    </div>
    <% if (sinPaquete.length) { %>
    <div class="dash-list">
      <% sinPaquete.forEach(p => { %>
      <div class="list-item">
        <div class="list-icon"><i class="fas fa-box-open"></i></div>
        <div style="flex:1">
          <div class="list-title"><%= p.nombre %> <%= p.apellido %></div>
          <div class="list-meta"><%= p.terapeuta_nombre || '—' %> · <%= p.telefono || 'Sin tel.' %></div>
        </div>
      </div>
      <% }) %>
    </div>
    <% } else { %><div class="list-empty">Todos los activos tienen paquete</div><% } %>
  </div>

  <%/* ── Paquetes vencidos con sesiones sin usar ── */%>
  <div class="card">
    <div class="card-header">
      <span><i class="fas fa-calendar-xmark"></i> Paquetes vencidos con sesiones</span>
      <span class="dash-badge dash-badge-red"><%= packVencidos.length %></span>
    </div>
    <% if (packVencidos.length) { %>
    <div class="dash-list">
      <% packVencidos.forEach(p => { %>
      <div class="list-item">
        <div class="list-icon"><i class="fas fa-calendar-xmark"></i></div>
        <div style="flex:1">
          <div class="list-title"><%= p.nombre %> <%= p.apellido %></div>
          <div class="list-meta"><%= p.pack_nombre %> · venció <%= new Date(p.vence_at).toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'numeric'}) %></div>
        </div>
        <span class="badge-riesgo"><%= p.sesiones_restantes %> ses.</span>
      </div>
      <% }) %>
    </div>
    <% } else { %><div class="list-empty">Sin paquetes vencidos con sesiones</div><% } %>
  </div>

  <%/* ── Ocupación por terapeuta ── */%>
  <div class="card">
    <div class="card-header">
      <span><i class="fas fa-users"></i> Ocupación por terapeuta</span>
    </div>
    <% if (ocupacion.length) { %>
    <div class="dash-list">
      <% ocupacion.forEach(t => { %>
      <div class="list-item">
        <div class="list-icon"><i class="fas fa-user-tie"></i></div>
        <div style="flex:1">
          <div class="list-title"><%= t.nombre %> <%= t.apellido %></div>
        </div>
        <span class="badge-ocupacion"><%= t.pacientes_asignados %> paciente<%= t.pacientes_asignados !== 1 ? 's' : '' %></span>
      </div>
      <% }) %>
    </div>
    <% } else { %><div class="list-empty">Sin terapeutas activos</div><% } %>
  </div>

</div>
