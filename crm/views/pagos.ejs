<div class="view-toolbar">
  <select class="form-select" id="pagosPacienteSelect" style="max-width:280px">
    <option value="">— Todos los pacientes —</option>
    <% pacientes.forEach(p => { %>
    <option value="<%= p.id %>"><%= p.nombre %> <%= p.apellido %></option>
    <% }) %>
  </select>
  <button class="btn btn-primary btn-sm" id="btnNuevoPago"><i class="fas fa-plus"></i> Registrar pago</button>
  <button class="btn btn-outline btn-sm" id="btnNuevoPack"><i class="fas fa-box"></i> Nuevo pack</button>
</div>
<div class="card">
  <table class="table">
    <thead><tr><th>Paciente</th><th>Monto</th><th>Método</th><th>Estado</th><th>Fecha</th></tr></thead>
    <tbody id="tablaPagos"></tbody>
  </table>
</div>

